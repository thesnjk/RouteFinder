{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routefinder.local/fleet-api-schema.json",
  "title": "RouteFinder Fleet API fragment",
  "description": "Optional JSON Schema fragment for FleetTrip + FleetJobBrief + walkaround handoff + GET /v1/proxy/status (FleetProxyDeskStatus). All jobBrief, inspection, forecast meter, and org identity fields are optional for backward-compatible clients.",
  "definitions": {
    "FleetProxyDeskStatus": {
      "type": "object",
      "description": "Body of GET /v1/proxy/status — ORS/forecast metering plus optional authenticated org identity (HOSTED-DESK).",
      "required": [
        "orsConfigured",
        "routesToday",
        "routeDailyCap",
        "geocodeToday",
        "geocodeDailyCap"
      ],
      "additionalProperties": true,
      "properties": {
        "orsConfigured": { "type": "boolean" },
        "routesToday": { "type": "integer", "minimum": 0 },
        "routeDailyCap": { "type": "integer", "minimum": 0 },
        "geocodeToday": { "type": "integer", "minimum": 0 },
        "geocodeDailyCap": { "type": "integer", "minimum": 0 },
        "tomTomConfigured": { "type": "boolean" },
        "openWeatherConfigured": { "type": "boolean" },
        "overpassConfigured": { "type": "boolean" },
        "tomTomToday": { "type": "integer", "minimum": 0 },
        "tomTomDailyCap": { "type": "integer", "minimum": 0 },
        "openWeatherToday": { "type": "integer", "minimum": 0 },
        "openWeatherDailyCap": { "type": "integer", "minimum": 0 },
        "overpassToday": { "type": "integer", "minimum": 0 },
        "overpassDailyCap": { "type": "integer", "minimum": 0 },
        "orgId": {
          "type": "string",
          "description": "Authenticated or default fleet org id when the server reports it."
        },
        "orgName": {
          "type": "string",
          "description": "Authenticated or default fleet org display name when the server reports it."
        }
      }
    },
    "FleetJobBrief": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "grossWeightKg": { "type": ["number", "null"] },
        "adrClass": { "type": ["string", "null"] },
        "timeWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stopId": { "type": "string", "format": "uuid" },
              "earliestArrival": { "type": ["string", "null"], "format": "date-time" },
              "latestArrival": { "type": ["string", "null"], "format": "date-time" }
            },
            "required": ["stopId"]
          }
        },
        "requestedVehicleProfileId": { "type": ["string", "null"], "format": "uuid" },
        "autoFindRoute": { "type": "boolean", "default": true },
        "autoRehearse": { "type": "boolean", "default": false }
      }
    },
    "TripBriefInspectionSummary": {
      "type": "object",
      "required": ["vehicleLabel", "defectCount", "completedAt"],
      "additionalProperties": true,
      "properties": {
        "vehicleLabel": { "type": "string" },
        "registrationPlate": { "type": ["string", "null"] },
        "defectCount": { "type": "integer", "minimum": 0 },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "FleetTripStop": {
      "type": "object",
      "required": ["id", "sequence", "label", "latitude", "longitude", "role"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sequence": { "type": "integer" },
        "label": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "role": { "enum": ["origin", "via", "destination"] }
      }
    },
    "FleetTrip": {
      "type": "object",
      "required": ["id", "orgId", "vehicleId", "status", "stops", "updatedAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "orgId": { "type": "string", "format": "uuid" },
        "vehicleId": { "type": "string", "format": "uuid" },
        "status": {
          "enum": ["draft", "dispatched", "accepted", "optimized", "rehearsed", "active", "completed"]
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/FleetTripStop" }
        },
        "vehicleProfile": { "type": ["object", "null"] },
        "jobBrief": { "$ref": "#/definitions/FleetJobBrief" },
        "physicsETASeconds": { "type": ["number", "null"] },
        "companyBreaks": { "type": "array" },
        "latestInspectionSummary": {
          "oneOf": [
            { "$ref": "#/definitions/TripBriefInspectionSummary" },
            { "type": "null" }
          ]
        },
        "inspectionReportPDFBase64": { "type": ["string", "null"] },
        "driverLatitude": { "type": ["number", "null"] },
        "driverLongitude": { "type": ["number", "null"] },
        "driverLocationRecordedAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
